      "response_intent": {
        "idle_low_load_support": true,
        "gpu_airflow": "moderate",
        "cpu_assist": "secondary_radiator_authority",
        "soft_floor_curve": [
          {"temp_c": 35.0, "duty_pct": 24.0},
          {"temp_c": 50.0, "duty_pct": 27.0},
          {"temp_c": 62.0, "duty_pct": 31.0},
          {"temp_c": 72.0, "duty_pct": 38.0}
        ]
