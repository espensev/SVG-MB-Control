    },
    {
      "channel": 5,
      "board_header": "CHA5",
      "name": "radiator_exhaust_b",
      "role": "radiator_exhaust",
      "direction": "exhaust",
      "fan_model": "Noctua NF-A14 industrialPPC PWM, 140 mm",
      "diameter_mm": 140,
      "release_min_duty_pct": 20.0,
      "reference_static_low_load_duty_pct": 20.0,
      "reference_static_low_load_rpm": 735,
      "response_intent": {
        "idle_bias": "slightly_above_rear_exhaust",
        "cpu_assist": "strong",
        "mirror_group": null
      }
    },
    {
      "channel": 6,
      "board_header": "CHA6",
      "name": "aio_or_pump_scope",
      "role": "aio_pump_scope",
      "direction": "excluded",
      "fan_model": "AIO/pump scope",
      "diameter_mm": null,
      "release_min_duty_pct": null,
      "reference_static_low_load_duty_pct": null,
      "reference_static_low_load_rpm": null,
